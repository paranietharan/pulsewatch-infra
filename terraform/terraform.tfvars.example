# ==============================================================================
# PulseWatch Infrastructure - Terraform Variables Example
# ==============================================================================

# AWS Region & Environment
aws_region  = "us-east-1"
environment = "prod"

# EKS Cluster
cluster_name    = "pulsewatch-eks"
cluster_version = "1.30"

# VPC Configuration
vpc_cidr           = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]
single_nat_gateway = true # Set to false for full multi-AZ NAT redundancy in critical production

# Worker Node Sizing
node_instance_types     = ["t3.large"]
node_group_desired_size = 3
node_group_min_size     = 2
node_group_max_size     = 6
node_disk_size          = 50

# Multi-Environment Namespaces
staging_namespace       = "staging"
production_namespace    = "production"
enable_namespace_quotas = false

# AWS RDS PostgreSQL
enable_rds               = true
db_instance_class        = "db.t4g.medium"
db_name                  = "pulsewatch"          # Production DB name
staging_db_name          = "pulsewatch_staging"  # Staging DB name
db_username              = "pulsewatch_admin"
db_password              = "YourSuperSecretDbPassw0rd!" # Or leave blank to auto-generate
db_allocated_storage     = 20
db_max_allocated_storage = 100
db_multi_az              = false # Set to true for production high availability failover

# ECR Container Registries
enable_ecr = true

# Domains & Ingress
domain_name             = "pulsewatch.yourdomain.com"
staging_domain_name     = "staging.pulsewatch.yourdomain.com"
production_domain_name  = "pulsewatch.yourdomain.com"
acm_certificate_arn     = "arn:aws:acm:us-east-1:123456789012:certificate/your-cert-id"

# Helm Deployment Automation (Set to true to deploy via Terraform, or false to use scripts/CI-CD)
deploy_staging_helm    = false
deploy_production_helm = false
