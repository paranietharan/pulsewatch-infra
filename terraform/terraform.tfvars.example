# ==============================================================================
# PulseWatch Infrastructure - Terraform Variables Example
# ==============================================================================

# AWS Region & Environment
aws_region  = "ap-south-1"
environment = "prod"

# EKS Cluster
cluster_name    = "pulsewatch-eks"
cluster_version = "1.31"

# VPC Configuration
vpc_cidr           = "10.0.0.0/16"
availability_zones = ["ap-south-1a", "ap-south-1b", "ap-south-1c"]
single_nat_gateway = true # Set to false for full multi-AZ NAT redundancy in critical production

# Worker Node Sizing (Cost-Effective / Free-Tier profile)
node_instance_types     = ["t3.small"]
node_group_desired_size = 2
node_group_min_size     = 2
node_group_max_size     = 6
node_disk_size          = 20

# Multi-Environment Namespaces
staging_namespace       = "staging"
production_namespace    = "production"
enable_namespace_quotas = false

# AWS RDS PostgreSQL
enable_rds               = true
db_engine_version        = "16.9"
db_instance_class        = "db.t3.micro"
db_name                  = "pulsewatch"          # Production DB name
staging_db_name          = "pulsewatch_staging"  # Staging DB name
db_username              = "pulsewatch_admin"
db_password              = ""                    # Leave empty to automatically generate a secure 24-character random password
db_allocated_storage     = 20
db_max_allocated_storage = 50
db_multi_az              = false # Set to true for production high availability failover
db_backup_retention_days = 0     # 0 disables automated snapshots (required for AWS Free Tier accounts)

# ECR Container Registries
enable_ecr = true

# Domains & Ingress (Optional: leave empty if you do not have a custom domain or ACM certificate yet)
domain_name            = ""
staging_domain_name    = ""
production_domain_name = ""
acm_certificate_arn    = ""

# Helm Deployment Automation (Set to true to deploy via Terraform, or false to use scripts/CLI)
deploy_staging_helm    = false
deploy_production_helm = false
